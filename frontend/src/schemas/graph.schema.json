      "additionalProperties": false,
      "properties": {
        "affected_concepts": {
          "items": {
            "type": "string"
          },
          "title": "Affected Concepts",
          "type": "array"
        },
        "analyzer": {
          "default": "python_ast",
          "title": "Analyzer",
          "type": "string"
        },
        "analyzer_version": {
          "default": "0.1.0",
          "title": "Analyzer Version",
          "type": "string"
        },
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "ANALYZED",
            "PARTIALLY_ANALYZED",
            "SKIPPED_BY_POLICY",
            "UNSUPPORTED_LANGUAGE",
            "PARSER_ERROR",
            "TIMEOUT",
            "NOT_ATTEMPTED",
            "EXCLUDED_GENERATED_OR_VENDOR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "status"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
